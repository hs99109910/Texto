<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded dark sheet so a confirmation prompt reads as part of the app's glass UI
     rather than arriving as a bright stock Material box. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/nova_dialog_bg" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="#26FFFFFF" />
</shape>
