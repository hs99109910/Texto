<?xml version="1.0" encoding="utf-8"?>
<!-- Background for a not-clickable, long-pressable item, like an SMS message row. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <selector>
            <item
                android:drawable="@color/texto_activated_item_foreground"
                android:state_selected="true" />
        </selector>
    </item>
    <item>
        <ripple android:color="@color/texto_pressed_item_foreground">
            <item android:id="@android:id/mask">
                <color android:color="@android:color/white" />
            </item>
        </ripple>
    </item>
</layer-list>
