<?xml version="1.0" encoding="utf-8"?>
<!--
    A solid SIM card silhouette, for the marker beside a day's messages.

    Filled rather than the Phosphor outline: at the size this is drawn, an outline collapses
    into a smudge and the slot colour is the whole of what the marker says, so the shape has
    to carry that colour across its whole area.

    The body runs y 3:21 of the 24 viewport rather than 2:22 : a card at the full height
    stood too tall beside the date. The width is unchanged, and the chamfer keeps its
    proportion to the height.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9.86,3 L17,3 C18.1,3 19,3.9 19,5 L19,19 C19,20.1 18.1,21 17,21 L7,21 C5.9,21 5,20.1 5,19 L5,7.86 Z" />
</vector>
