<?xml version="1.0" encoding="utf-8"?>
<!--
    The frosted square each settings row's icon sits in. A flat white wash rather than a
    themed colour: it has to read as "inset" on both the dark and light grounds, and the
    icon itself is tinted to the theme at runtime.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1AFFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#1FFFFFFF" />
    <corners android:radius="13dp" />
</shape>
