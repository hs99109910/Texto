<?xml version="1.0" encoding="utf-8"?>
<!-- Neutral grey tints so the row reads correctly whether the dialog renders light or dark. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33808080">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14808080" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#33808080" />
        </shape>
    </item>
</ripple>
