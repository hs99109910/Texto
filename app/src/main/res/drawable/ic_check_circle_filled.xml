<?xml version="1.0" encoding="utf-8"?>
<!--
  Selection badge. Three rings so it stays readable on any card colour: a dark halo,
  a white ring, then the blue disc carrying a white tick.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Dark halo, so the white ring still reads on a white card. -->
    <path
        android:fillColor="#59000000"
        android:pathData="M12,12m-12,0a12,12 0,1 0,24 0a12,12 0,1 0,-24 0" />
    <!-- White ring. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,12m-11,0a11,11 0,1 0,22 0a11,11 0,1 0,-22 0" />
    <!-- Blue disc. -->
    <path
        android:fillColor="#FF2F6BFF"
        android:pathData="M12,12m-9,0a9,9 0,1 0,18 0a9,9 0,1 0,-18 0" />
    <!-- Tick. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10.4,16.0 L6.4,12 L7.8,10.6 L10.4,13.2 L16.2,7.4 L17.6,8.8 Z" />
</vector>
