<?xml version="1.0" encoding="utf-8"?>
<!--
  Delivered: two ticks overlapping, the second offset by a few units so they read as one
  mark rather than two separate icons. Same stroke weight as ic_check_single.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="16dp"
    android:viewportWidth="30"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <!-- Trailing tick, drawn first so the leading one overlaps it. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M15,16.2 L10.8,12 L9.4,13.4 L15,19 L27,7 L25.6,5.6 Z" />
    <!-- Leading tick. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M7,16.2 L2.8,12 L1.4,13.4 L7,19 L19,7 L17.6,5.6 Z" />
</vector>
