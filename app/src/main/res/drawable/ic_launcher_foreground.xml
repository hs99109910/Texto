<?xml version="1.0" encoding="utf-8"?>
<!--
  A frosted speech bubble. Everything is white at low alpha so the orange field shows
  through like tinted glass, with a bright rim and a top sheen for the glass read.
  Drawn inside the 72dp safe zone of the 108dp adaptive-icon canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 0.85 scale about the canvas centre: the bubble 15% smaller in its safe zone. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.68"
        android:scaleY="0.68"
        android:translateX="0"
        android:translateY="-2">

        <!-- Drop shadow under the bubble. -->
        <path
            android:pathData="M32,29h44a13,13 0,0 1,13 13v25a13,13 0,0 1,-13 13h-19l-15,13 3,-13h-13a13,13 0,0 1,-13 -13v-25a13,13 0,0 1,13 -13z"
            android:fillColor="#22000000" />

        <!-- Glass body. -->
        <path android:pathData="M32,27h44a13,13 0,0 1,13 13v25a13,13 0,0 1,-13 13h-19l-15,13 3,-13h-13a13,13 0,0 1,-13 -13v-25a13,13 0,0 1,13 -13z">
            <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
                <gradient
                    android:startX="32"
                    android:startY="27"
                    android:endX="89"
                    android:endY="91"
                    android:type="linear">
                    <item android:color="#F2FFFFFF" android:offset="0" />
                    <item android:color="#B8FFFFFF" android:offset="0.55" />
                    <item android:color="#8CFFFFFF" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Bright rim. -->
        <path
            android:pathData="M32,27h44a13,13 0,0 1,13 13v25a13,13 0,0 1,-13 13h-19l-15,13 3,-13h-13a13,13 0,0 1,-13 -13v-25a13,13 0,0 1,13 -13z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2"
            android:strokeAlpha="0.85"
            android:fillColor="#00000000" />

        <!-- Sheen across the upper half. -->
        <path android:pathData="M40,29h30c-4,12 -20,20 -38,19v-6a13,13 0,0 1,8 -13z">
            <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
                <gradient
                    android:startX="54"
                    android:startY="27"
                    android:endX="54"
                    android:endY="50"
                    android:type="linear">
                    <item android:color="#99FFFFFF" android:offset="0" />
                    <item android:color="#00FFFFFF" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Three dots, tinted with the field colour so they stay legible. -->
        <path
            android:pathData="M43,52m-4.5,0a4.5,4.5 0,1 1,9 0a4.5,4.5 0,1 1,-9 0"
            android:fillColor="#E5620A" />
        <path
            android:pathData="M54,52m-4.5,0a4.5,4.5 0,1 1,9 0a4.5,4.5 0,1 1,-9 0"
            android:fillColor="#E5620A" />
        <path
            android:pathData="M65,52m-4.5,0a4.5,4.5 0,1 1,9 0a4.5,4.5 0,1 1,-9 0"
            android:fillColor="#E5620A" />
    </group>
</vector>
