<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher's ground. The design's own near-black, lifted toward the mark's violet end
    across the diagonal so the blue:to:purple stroke has something to sit against without the
    icon reading as a flat black tile among other launcher icons.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF0B1020" />
                <item android:offset="0.55" android:color="#FF141A2E" />
                <item android:offset="1" android:color="#FF1E1436" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
