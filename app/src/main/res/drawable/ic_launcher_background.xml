<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher's ground: the brand's own gradient, running cyan at the upper left to deep
    blue at the lower right.

    The three stops are sampled from the supplied artwork rather than eyeballed : #4FDCED at
    the top left, #116AEA through the middle, #151B95 at the bottom right : and the middle
    one is not optional: the blend between the two ends alone passes well below the cyan and
    the tile turns flat and purple-ish in the top corner.

    Full bleed, deliberately. An adaptive icon's background is masked to whatever shape the
    launcher uses, so a circle painted here would leave bare corners under a squircle mask.
    The mark itself is the circle; this is the field it is cut out of.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="6"
                android:startY="6"
                android:endX="102"
                android:endY="102">
                <item android:offset="0" android:color="#FF4FDCED" />
                <item android:offset="0.45" android:color="#FF116AEA" />
                <item android:offset="1" android:color="#FF151B95" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
