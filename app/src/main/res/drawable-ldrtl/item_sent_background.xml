<?xml version="1.0" encoding="utf-8"?>
<!-- Mirror of drawable/item_sent_background.xml: the small "tail" corner moves from
     bottom-right to bottom-left under RTL, since a sent bubble stays on the layout's end
     side either way. Commons' own dimens and a stray colour here were replaced with the
     same values the LTR file already uses. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#D8D8D8" />
    <corners
        android:bottomLeftRadius="4dp"
        android:bottomRightRadius="18dp"
        android:topLeftRadius="18dp"
        android:topRightRadius="18dp" />
</shape>
