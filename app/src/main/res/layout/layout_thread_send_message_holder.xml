<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/message_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <RelativeLayout
        android:id="@+id/scheduled_message_holder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="@dimen/medium_margin"
        android:layout_marginEnd="16dp"
        android:background="@drawable/section_holder_stroke"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/thread_attachments_recyclerview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="@dimen/medium_margin"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/scheduled_message_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/scheduled_message_button"
            android:layout_alignBottom="@+id/scheduled_message_button"
            android:paddingStart="@dimen/medium_margin"
            android:paddingTop="@dimen/medium_margin"
            android:paddingEnd="@dimen/small_margin"
            android:paddingBottom="@dimen/medium_margin"
            android:src="@drawable/ic_clock_vector" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/scheduled_message_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_toStartOf="@+id/discard_scheduled_message"
            android:layout_toEndOf="@+id/scheduled_message_icon"
            android:background="@drawable/ripple_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/normal_icon_size"
            android:paddingStart="@dimen/small_margin"
            android:paddingEnd="@dimen/activity_margin"
            android:textSize="@dimen/middle_text_size"
            tools:ignore="HardcodedText"
            tools:text="Tomorrow at 6PM GMT +05:30" />

        <ImageView
            android:id="@+id/discard_scheduled_message"
            android:layout_width="@dimen/normal_icon_size"
            android:layout_height="@dimen/normal_icon_size"
            android:layout_alignParentEnd="true"
            android:layout_gravity="end"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel_schedule_send"
            android:padding="@dimen/normal_margin"
            android:src="@drawable/ic_cross_vector" />

    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/thread_attachments_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="@dimen/tiny_margin"
        android:layout_marginBottom="@dimen/small_margin"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/texto_message_bar_row"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginTop="@dimen/medium_margin"
        tools:itemCount="2"
        tools:listitem="@layout/item_attachment_document_preview"
        tools:visibility="visible" />

    <!--
        The design's composer: ONE capsule holding everything, rather than the field and a
        separate send disc sitting side by side. Children run in DOM order, which under the
        app's right-to-left layout puts the first child against the right edge, so the order
        below reads on screen as: clip (far right), SIM, the text, then send (far left) -
        exactly the arrangement the mockup draws.

        texto_message_bar_row is a bare container with no fill of its own; every surface here
        belongs to the capsule.
    -->
    <LinearLayout
        android:id="@+id/texto_message_bar_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:paddingHorizontal="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/texto_message_input_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/texto_searchbar_bg"
            android:gravity="bottom"
            android:minHeight="60dp"
            android:padding="6dp">

            <!-- ATTACH. First child: the far right of the capsule under RTL. -->
            <ImageView
                android:id="@+id/thread_add_attachment"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/attachment"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ph_paperclip" />

            <!--
                SIM. A 38dp disc like the clip, with the active SIM's digit riding its upper
                corner as a small badge, the way the design draws it.
            -->
            <FrameLayout
                android:id="@+id/thread_sim_holder"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/thread_select_sim_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/select_sim_card"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ph_sim_card"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/thread_select_sim_number"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|start"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textSize="9sp"
                    android:visibility="gone"
                    tools:ignore="SmallSp"
                    tools:text="1"
                    tools:visibility="visible" />
            </FrameLayout>

            <org.fossify.commons.views.MyEditText
                android:id="@+id/thread_type_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="center_vertical"
                android:hint="@string/type_a_message"
                android:paddingHorizontal="6dp"
                android:paddingVertical="11dp"
                android:textColorHint="#888888"
                android:textColor="@android:color/white"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="8" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/thread_character_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:paddingStart="@dimen/small_margin"
                android:paddingEnd="@dimen/small_margin"
                android:text="0"
                android:textColor="@android:color/white"
                android:textSize="@dimen/normal_text_size"
                android:visibility="gone"
                tools:ignore="HardcodedText"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/thread_add_emoji"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/insert_emoji"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ph_smiley" />

            <!--
                SEND. Last child: the far left of the capsule under RTL, as the design has it.

                An ImageView rather than a Button carrying a compound drawable. As a
                `drawableStart` the glyph is laid out against the start edge of the (empty)
                text block instead of the middle of the control, which left it off-centre and
                clipped by the 44dp disc. scaleType=fitCenter puts it where it belongs.
            -->
            <ImageView
                android:id="@+id/thread_send_message"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:alpha="0.4"
                android:clickable="false"
                android:contentDescription="@string/ok"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ph_paper_plane_right" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
