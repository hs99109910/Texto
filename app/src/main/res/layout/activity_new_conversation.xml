<?xml version="1.0" encoding="utf-8"?>
<!--
    The contact picker, for a new conversation and for attaching a contact card.

    Rebuilt around the order people use it in: the field comes first, directly under the
    header, rather than as a collapsed pill at the foot of the screen that had to be tapped
    open and then sat on top of the last row. A number typed into it that nobody in the phone
    book has gets a row of its own saying who the message will go to.

    Every colour and most sizes are set in NewConversationActivity from the live theme and the
    UI scale; nothing here is painted.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/new_conversation_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.texto.sms.views.TextoAppBarLayout
        android:id="@+id/new_conversation_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/new_conversation_toolbar"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@android:color/transparent"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp">

            <TextView
                android:id="@+id/new_conversation_toolbar_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:ellipsize="end"
                android:maxLines="1"
                android:textStyle="bold"
                android:text="@string/new_conversation" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.texto.sms.views.TextoAppBarLayout>

    <RelativeLayout
        android:id="@+id/new_conversation_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/new_conversation_search_container"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_alignParentTop="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/new_conversation_search_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search_vector" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/new_conversation_address"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="center_vertical|start"
                android:hint="@string/add_contact_or_number"
                android:imeOptions="actionGo"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:textAlignment="viewStart" />

            <!--
                Switches the field between searching by name and dialling a number outright.
                The field is a name search by default, so a number had to be typed on the
                alphabetic keyboard : there was no way to ask for a keypad.
            -->
            <ImageView
                android:id="@+id/new_conversation_keypad_toggle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/switch_to_keypad"
                android:padding="11dp"
                android:src="@drawable/ic_ph_numpad" />

            <ImageView
                android:id="@+id/new_conversation_confirm"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_confirm"
                android:padding="11dp"
                android:src="@drawable/ic_ph_check"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Shown for a typed number that matches nobody: says where the message will go. -->
        <LinearLayout
            android:id="@+id/new_conversation_direct_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/new_conversation_search_container"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/new_conversation_direct_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no"
                android:padding="11dp"
                android:src="@drawable/ic_ph_chat_circle_text" />

            <TextView
                android:id="@+id/new_conversation_direct_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textStyle="bold"
                tools:text="@string/send_to_number" />
        </LinearLayout>

        <!-- Starts picking the members of a group, on this same list. -->
        <LinearLayout
            android:id="@+id/new_conversation_group_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/new_conversation_direct_row"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/new_conversation_group_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/ic_ph_users" />

            <TextView
                android:id="@+id/new_conversation_group_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/create_group"
                android:textAlignment="viewStart" />
        </LinearLayout>

        <!-- While a group is being picked: who is in it so far, and the way to start it. -->
        <LinearLayout
            android:id="@+id/new_conversation_group_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/new_conversation_group_row"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <com.texto.sms.helpers.TextoFlowLayout
                android:id="@+id/new_conversation_group_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/new_conversation_group_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/group_pick_hint"
                    android:textAlignment="viewStart" />

                <TextView
                    android:id="@+id/new_conversation_group_done"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:maxLines="1"
                    tools:text="@string/group_create_action" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/no_contacts_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/new_conversation_group_panel"
            android:gravity="center"
            android:text="@string/no_access_to_contacts"
            android:visibility="gone" />

        <TextView
            android:id="@+id/no_contacts_placeholder_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/no_contacts_placeholder"
            android:layout_centerHorizontal="true"
            android:text="@string/request_the_required_permissions"
            android:visibility="gone" />

        <com.texto.sms.views.TextoRecyclerView
            android:id="@+id/contacts_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/new_conversation_group_panel"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/texto_layout_animation"
            android:overScrollMode="ifContentScrolls"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            android:scrollbars="none"
            app:layoutManager="com.texto.sms.views.TextoLinearLayoutManager" />

        <com.reddit.indicatorfastscroll.FastScrollerView
            android:id="@+id/contacts_letter_fastscroller"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/contacts_list"
            android:layout_alignParentEnd="true"
            android:paddingTop="@dimen/texto_big_margin"
            android:paddingBottom="@dimen/texto_big_margin"
            android:visibility="gone" />

        <com.reddit.indicatorfastscroll.FastScrollerThumbView
            android:id="@+id/contacts_letter_fastscroller_thumb"
            android:layout_width="@dimen/texto_fab_size"
            android:layout_height="match_parent"
            android:layout_alignTop="@+id/contacts_letter_fastscroller"
            android:layout_alignBottom="@+id/contacts_letter_fastscroller"
            android:layout_marginEnd="@dimen/texto_activity_margin"
            android:layout_toStartOf="@+id/contacts_letter_fastscroller"
            android:visibility="gone" />

    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
