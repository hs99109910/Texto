<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/thread_message_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/small_margin"
    android:paddingHorizontal="@dimen/activity_margin">

    <RelativeLayout
        android:id="@+id/thread_message_wrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.8">

        <ImageView
            android:id="@+id/thread_message_sender_photo"
            android:layout_width="@dimen/list_icon_size_medium"
            android:layout_height="@dimen/list_icon_size_medium"
            android:layout_alignBottom="@+id/thread_message_body_holder"
            android:layout_alignParentStart="true"
            android:layout_marginEnd="@dimen/medium_margin"
            android:src="@drawable/ic_person_vector"
            android:visibility="gone"
            tools:ignore="ContentDescription"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/thread_message_attachments_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/thread_message_sender_photo"
            android:divider="@drawable/linear_layout_vertical_divider"
            android:orientation="vertical"
            android:showDividers="middle" />

        <ImageView
            android:id="@+id/thread_message_play_outline"
            android:layout_width="@dimen/play_outline_size"
            android:layout_height="@dimen/play_outline_size"
            android:layout_alignEnd="@+id/thread_message_attachments_holder"
            android:layout_alignBottom="@+id/thread_message_attachments_holder"
            android:layout_marginEnd="@dimen/medium_margin"
            android:layout_marginBottom="@dimen/activity_margin"
            android:src="@drawable/ic_play_outline_vector"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <FrameLayout
            android:id="@+id/thread_message_body_holder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/thread_message_attachments_holder"
            android:layout_marginVertical="@dimen/tiny_margin"
            android:layout_alignParentEnd="true"
            android:background="@drawable/item_sent_background"
            android:clickable="true"
            android:focusable="true">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/thread_message_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:padding="@dimen/normal_margin"
                android:textSize="@dimen/normal_text_size"
                tools:drawableEndCompat="@drawable/scheduled_message_icon"
                tools:text="Message content" />
        </FrameLayout>

        <org.fossify.commons.views.MyTextView
            android:id="@+id/thread_message_carrier_warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/thread_message_body_holder"
            android:layout_alignEnd="@+id/thread_message_body_holder"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="4dp"
            android:text="Some carriers may limit this to 3MB or less"
            android:textSize="10sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <View
            android:id="@+id/selection_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignTop="@id/thread_message_attachments_holder"
            android:layout_alignBottom="@id/thread_message_body_holder"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/selection_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignTop="@id/thread_message_body_holder"
            android:layout_alignStart="@id/thread_message_body_holder"
            android:layout_marginTop="3dp"
            android:layout_marginStart="3dp"
            android:contentDescription="@string/selected"
            android:elevation="6dp"
            android:src="@drawable/ic_check_circle_filled"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Single tick once the network accepts the message, double once the carrier
             reports it delivered. -->
        <ImageView
            android:id="@+id/delivery_status"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_below="@+id/thread_message_body_holder"
            android:layout_alignEnd="@+id/thread_message_body_holder"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="4dp"
            android:alpha="0.75"
            android:contentDescription="@string/delivered"
            android:src="@drawable/ic_check_single"
            android:visibility="gone"
            tools:visibility="visible" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/message_reaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/thread_message_body_holder"
            android:layout_alignStart="@id/thread_message_body_holder"
            android:layout_marginTop="-10dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/pill_background_small"
            android:elevation="4dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="👍"
            tools:visibility="visible" />
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
