<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/persian_date_picker_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/activity_margin"
    android:paddingVertical="@dimen/activity_margin">

    <LinearLayout
        android:id="@+id/quick_pick_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/quick_pick_tomorrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/small_margin"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingVertical="@dimen/normal_margin"
            android:text="@string/tomorrow"
            android:textSize="@dimen/normal_text_size"
            tools:text="فردا" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/quick_pick_day_after_tomorrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/small_margin"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingVertical="@dimen/normal_margin"
            android:text="@string/day_after_tomorrow"
            android:textSize="@dimen/normal_text_size"
            tools:text="پس‌فردا" />

    </LinearLayout>

    <org.fossify.commons.views.MyTextView
        android:id="@+id/custom_date_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/big_margin"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/or_pick_a_custom_date" />

    <LinearLayout
        android:id="@+id/number_picker_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/small_margin"
        android:gravity="center"
        android:orientation="horizontal">

        <NumberPicker
            android:id="@+id/day_picker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <NumberPicker
            android:id="@+id/month_picker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2" />

        <NumberPicker
            android:id="@+id/year_picker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>
