<?xml version="1.0" encoding="utf-8"?>
<!--
    A filter chip: its label plus how many conversations currently fall into it. Both the
    pill background and the badge are painted at runtime from the active theme, so nothing
    here carries a colour.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/filter_chip_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/filter_chip_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1" />

    <TextView
        android:id="@+id/filter_chip_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:minWidth="16dp"
        android:visibility="gone"
        tools:ignore="SmallSp"
        xmlns:tools="http://schemas.android.com/tools" />

</LinearLayout>
