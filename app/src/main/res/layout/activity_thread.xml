<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/thread_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <com.texto.sms.views.TextoAppBarLayout
        android:id="@+id/thread_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/thread_toolbar"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@android:color/transparent"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp"
            app:contentInsetEnd="0dp"
            app:contentInsetEndWithActions="0dp"
            app:popupTheme="@style/TextoPopupTheme">

            <!--
                The design's thread header, as one row: back, who you are talking to, and
                the two actions. It follows the locale, so under Persian the back tile is on
                the right and the actions fall to the left, which is how the mockup draws it.
                The tiles' fills and radii are repainted from the live theme in
                ThreadActivity.styleThreadHeader.

                The 22dp is `TextoGlass.FLOATING_BAR_INSET_DP` plus room to clear the corner,
                and it must match the home header's `texto_header_row`. This row is the full
                screen width while the capsule painted behind it is inset 16dp, so padding
                below that inset puts the end tiles *outside* the bar. At 12dp they did:
                measured on a 1080px screen, the capsule ran 42..1038 while the back tile
                started at 32 and the overflow tile ended at 1048 : 10px over the edge at
                each end. Turning the bars into true capsules is what exposed it, since the
                corner radius went from 26dp to half the bar's height.
            -->
            <LinearLayout
                android:id="@+id/thread_header_row"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="22dp"
                android:paddingEnd="22dp">

                <ImageView
                    android:id="@+id/thread_back_btn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:contentDescription="@string/back"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@drawable/ic_ph_arrow_left"
                    app:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/thread_header_avatar"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="12dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    tools:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/thread_toolbar_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="#FFFFFF"
                        android:textDirection="anyRtl"
                        android:textSize="15.5sp"
                        tools:text="نام مخاطب" />

                    <!--
                        SMS has no presence to report, so this line carries what the app
                        actually knows about the other side: their number, or how many
                        people are in the group.
                    -->
                    <TextView
                        android:id="@+id/thread_header_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textDirection="locale"
                        android:textSize="11.5sp"
                        android:visibility="gone"
                        tools:text="+98 912 118 4402"
                        tools:visibility="visible" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/thread_search_btn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:contentDescription="@string/search_in_thread"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@drawable/ic_ph_magnifying_glass"
                    app:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/thread_menu_btn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:contentDescription="@string/more_options"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@drawable/ic_ph_dots_three_vertical"
                    app:tint="#FFFFFF" />

            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

        <!--
            In-thread search. Sits under the header capsule and only appears once the header's
            magnifier is tapped, so a thread you are only reading keeps its full height.
        -->
        <LinearLayout
            android:id="@+id/thread_search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="12dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/thread_search_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ph_magnifying_glass" />

            <EditText
                android:id="@+id/thread_search_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/search_in_thread"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textAlignment="viewStart"
                android:textDirection="locale" />

            <TextView
                android:id="@+id/thread_search_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:includeFontPadding="false"
                tools:text="۳ نتیجه" />

            <ImageView
                android:id="@+id/thread_search_close"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:clickable="true"
                android:contentDescription="@string/clear_search"
                android:focusable="true"
                android:src="@drawable/ic_ph_x" />

        </LinearLayout>

    </com.texto.sms.views.TextoAppBarLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/thread_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <RelativeLayout
            android:id="@+id/thread_add_contacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/selected_contacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/texto_activity_margin"
                android:orientation="vertical" />

            <ImageView
                android:id="@+id/confirm_manage_contacts"
                android:layout_width="@dimen/texto_normal_icon_size"
                android:layout_height="@dimen/texto_normal_icon_size"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="@dimen/texto_medium_margin"
                android:layout_marginTop="@dimen/texto_normal_margin"
                android:layout_marginEnd="@dimen/texto_medium_margin"
                android:background="?selectableItemBackgroundBorderless"
                android:padding="@dimen/texto_small_margin"
                android:src="@drawable/ic_ph_check" />

            <View
                android:id="@+id/message_divider_one"
                android:layout_width="match_parent"
                android:layout_height="@dimen/texto_divider_height"
                android:layout_below="@+id/selected_contacts"
                android:background="@color/texto_divider_grey"
                android:importantForAccessibility="no" />

            <android.widget.AutoCompleteTextView
                android:id="@+id/add_contact_or_number"
                android:layout_width="match_parent"
                android:layout_height="@dimen/texto_normal_icon_size"
                android:layout_below="@+id/message_divider_one"
                android:layout_marginStart="@dimen/texto_activity_margin"
                android:layout_marginEnd="@dimen/texto_activity_margin"
                android:layout_toStartOf="@+id/confirm_inserted_number"
                android:background="@android:color/transparent"
                android:completionThreshold="2"
                android:gravity="center_vertical"
                android:hint="@string/add_contact_or_number"
                android:inputType="textCapWords"
                android:textSize="@dimen/texto_big_text_size" />

            <ImageView
                android:id="@+id/confirm_inserted_number"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignTop="@+id/add_contact_or_number"
                android:layout_alignBottom="@+id/add_contact_or_number"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="@dimen/texto_medium_margin"
                android:layout_marginEnd="@dimen/texto_medium_margin"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@string/confirm_selection"
                android:paddingStart="@dimen/texto_medium_margin"
                android:paddingEnd="@dimen/texto_medium_margin"
                android:src="@drawable/ic_ph_check"
                android:visibility="gone" />

            <View
                android:id="@+id/message_divider_two"
                android:layout_width="match_parent"
                android:layout_height="@dimen/texto_divider_height"
                android:layout_below="@+id/add_contact_or_number"
                android:background="@color/texto_divider_grey"
                android:importantForAccessibility="no" />

        </RelativeLayout>

        <com.texto.sms.views.TextoRecyclerView
            android:id="@+id/thread_messages_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:overScrollMode="ifContentScrolls"
            android:paddingTop="12dp"
            android:paddingBottom="86dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/thread_add_contacts"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layoutManager="com.texto.sms.views.TextoLinearLayoutManager"
            app:stackFromEnd="true"
            tools:itemCount="3"
            tools:listitem="@layout/item_message" />

        <!-- Says so when a search matches nothing, instead of leaving a blank thread. -->
        <TextView
            android:id="@+id/thread_search_empty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:gravity="center"
            android:layout_marginTop="48dp"
            android:text="@string/search_no_results"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/thread_messages_list"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/scrollToBottomFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:text="↓"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/message_holder" />

        <include
            android:id="@+id/short_code_holder"
            layout="@layout/layout_invalid_short_code_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/message_holder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible" />

        <include
            android:id="@+id/message_holder"
            layout="@layout/layout_thread_send_message_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@id/emoji_panel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!--
            The emoji panel sits where the keyboard sits, so the composer rides above it and
            the send button stays reachable while you pick. Height is set at runtime from the
            keyboard's own measured height, so the two swap without the composer moving.
            While it is gone ConstraintLayout collapses it against the bottom edge, which is
            where the composer then lands: the normal state needs no second constraint.
        -->
        <FrameLayout
            android:id="@+id/emoji_panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--
        The contextual selection bar floats over the thread rather than sitting inside the app
        bar, which is where it used to be: as a second child it grew the app bar by its own
        height the instant a long-press selected a message, and the message list, laid out
        below the app bar, was resized in the same pass. `stackFromEnd` then re-anchored the
        thread to its newest message and the item animator glided it there, 53px a frame,
        measured: that was the jump you saw before the menu appeared. Over the list instead of
        above it, nothing is resized and nothing moves. Its top margin is set from the
        toolbar's own bottom, so it still lands exactly where it did.
    -->
    <include
        android:id="@+id/selection_bar"
        layout="@layout/layout_selection_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:elevation="14dp" />

    <!--
        The appearance editor's bar, floating over the thread for the same reason the
        selection bar does: while it is up the thread behind it is what you are restyling, so
        it must not move. Painted and positioned at runtime, like every other floating bar.
    -->
    <LinearLayout
        android:id="@+id/appearance_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:elevation="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/appearance_cancel"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/appearance_discard"
            android:padding="11dp"
            android:src="@drawable/ic_ph_x" />

        <TextView
            android:id="@+id/appearance_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="@string/appearance_edit_hint"
            android:textAlignment="viewStart" />

        <TextView
            android:id="@+id/appearance_background_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/filter_colour_background" />

        <TextView
            android:id="@+id/appearance_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/appearance_edit_done" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
