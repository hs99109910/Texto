<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/recent_selection_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="1dp"
        android:background="@drawable/selection_glow_bg"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recent_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="3dp"
        android:padding="10dp"
        android:background="@drawable/pill_background_recent_1">

        <ImageView
            android:id="@+id/recent_image"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:src="@mipmap/ic_launcher"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/recent_selection_check"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/selected"
            android:elevation="8dp"
            android:src="@drawable/ic_check_circle_filled"
            android:translationZ="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/recent_image"
            app:layout_constraintEnd_toEndOf="@id/recent_image"
            app:layout_constraintStart_toStartOf="@id/recent_image"
            app:layout_constraintTop_toTopOf="@id/recent_image"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/recent_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            app:layout_constraintBottom_toTopOf="@id/recent_body"
            app:layout_constraintEnd_toStartOf="@id/recent_date"
            app:layout_constraintStart_toEndOf="@id/recent_image"
            app:layout_constraintTop_toTopOf="@id/recent_image"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="+1765001009" />

        <TextView
            android:id="@+id/recent_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:textSize="14sp"
            android:textColor="#444444"
            app:layout_constraintBottom_toBottomOf="@id/recent_image"
            app:layout_constraintEnd_toStartOf="@id/recent_pin_indicator"
            app:layout_constraintStart_toEndOf="@id/recent_image"
            app:layout_constraintTop_toBottomOf="@id/recent_address"
            tools:text="Is this Gary?" />

        <TextView
            android:id="@+id/recent_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:textSize="12sp"
            android:textColor="#000000"
            app:layout_constraintBaseline_toBaselineOf="@id/recent_address"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="6 May" />

        <ImageView
            android:id="@+id/recent_pin_indicator"
            android:layout_width="@dimen/small_icon_size"
            android:layout_height="@dimen/small_icon_size"
            android:alpha="0.7"
            android:padding="@dimen/tiny_margin"
            android:src="@drawable/ic_pin_filled_vector"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/recent_body"
            app:layout_constraintEnd_toStartOf="@id/recent_unread_badge"
            app:layout_constraintTop_toTopOf="@id/recent_body"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/recent_unread_badge"
            android:layout_width="@dimen/small_icon_size"
            android:layout_height="@dimen/small_icon_size"
            android:background="@drawable/circle_background"
            android:gravity="center"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/recent_body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/recent_body"
            tools:text="42"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
