<?xml version="1.0" encoding="utf-8"?>
<!--
    A thread row from the Nocturne design: a 22dp card of the card colour at 42%, no border,
    a 44dp squircle avatar, and the name/time on one baseline over the preview/badge line.
    Sizes here are the design's; BaseConversationsAdapter rescales them for the UI-scale
    setting and paints the card from the live theme.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/recent_selection_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="4dp"
        android:background="@drawable/selection_glow_bg"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recent_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="7dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="15dp"
        android:background="@drawable/pill_background_recent_1">

        <ImageView
            android:id="@+id/recent_image"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:src="@mipmap/ic_launcher"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/recent_selection_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/selected"
            android:elevation="8dp"
            android:src="@drawable/ic_check_circle_filled"
            android:translationZ="8dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/recent_image"
            app:layout_constraintEnd_toEndOf="@id/recent_image"
            app:layout_constraintStart_toStartOf="@id/recent_image"
            app:layout_constraintTop_toTopOf="@id/recent_image"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/recent_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:textSize="15sp"
            android:textColor="#F2F3F8"
            app:layout_constraintBottom_toTopOf="@id/recent_body"
            app:layout_constraintEnd_toStartOf="@id/recent_date"
            app:layout_constraintStart_toEndOf="@id/recent_image"
            app:layout_constraintTop_toTopOf="@id/recent_image"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="+1765001009" />

        <TextView
            android:id="@+id/recent_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:textSize="13sp"
            android:textColor="#94F2F3F8"
            app:layout_constraintBottom_toBottomOf="@id/recent_image"
            app:layout_constraintEnd_toStartOf="@id/recent_pin_indicator"
            app:layout_constraintStart_toEndOf="@id/recent_image"
            app:layout_constraintTop_toBottomOf="@id/recent_address"
            tools:text="Is this Gary?" />

        <TextView
            android:id="@+id/recent_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#5CF2F3F8"
            app:layout_constraintBaseline_toBaselineOf="@id/recent_address"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="6 May" />

        <ImageView
            android:id="@+id/recent_pin_indicator"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_ph_push_pin"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/recent_body"
            app:layout_constraintEnd_toStartOf="@id/recent_unread_badge"
            app:layout_constraintTop_toTopOf="@id/recent_body"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/recent_unread_badge"
            android:layout_width="wrap_content"
            android:layout_height="19dp"
            android:minWidth="19dp"
            android:paddingHorizontal="5dp"
            android:background="@drawable/circle_background"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/recent_body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/recent_body"
            tools:text="42"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
