<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/conversation_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/texto_tiny_margin"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/texto_two_line_list_item_min_height"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!--
        Decoration, not information: the monogram or photo repeats the name on the line beside
        it. Left focusable, a screen reader stopped on every row twice and read the drawable's
        own name at the first stop.
    -->
    <ImageView
        android:id="@+id/conversation_image"
        android:layout_width="@dimen/texto_list_icon_size_medium"
        android:layout_height="@dimen/texto_list_icon_size_medium"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@mipmap/ic_launcher" />

    <!--
        The avatar is centred on the row and the two text lines form one packed chain, so a
        contact with only a name has that name centred too. The avatar used to span from the
        name's top to the number's bottom: with the number gone it hung below a top-aligned
        name and held a two-line height open under it.
    -->
    <TextView
        android:id="@+id/conversation_address"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textDirection="locale"
        android:textSize="@dimen/texto_list_primary_text_size"
        app:layout_constraintBottom_toTopOf="@id/conversation_body_short"
        app:layout_constraintEnd_toStartOf="@id/conversation_date"
        app:layout_constraintStart_toEndOf="@id/conversation_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="John" />

    <TextView
        android:id="@+id/draft_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/texto_small_margin"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/draft"
        android:textAlignment="viewStart"
        android:textDirection="locale"
        android:textSize="@dimen/texto_list_secondary_text_size"
        android:textStyle="italic"
        app:layout_constraintBottom_toBottomOf="@id/conversation_body_short"
        app:layout_constraintEnd_toStartOf="@id/conversation_body_short"
        app:layout_constraintStart_toStartOf="@id/conversation_address"
        app:layout_constraintTop_toTopOf="@id/conversation_body_short" />

    <TextView
        android:id="@+id/conversation_body_short"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/texto_activity_margin"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textDirection="locale"
        android:textSize="@dimen/texto_normal_text_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/pin_indicator"
        app:layout_constraintStart_toEndOf="@id/draft_indicator"
        app:layout_constraintTop_toBottomOf="@id/conversation_address"
        tools:text="Hey buddy!" />

    <TextView
        android:id="@+id/conversation_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.7"
        android:textAlignment="viewStart"
        android:textDirection="locale"
        android:textSize="@dimen/texto_list_tertiary_text_size"
        app:layout_constraintBottom_toBottomOf="@id/conversation_address"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/conversation_address"
        tools:text="13:30" />

    <ImageView
        android:id="@+id/pin_indicator"
        android:layout_width="@dimen/small_icon_size"
        android:layout_height="@dimen/small_icon_size"
        android:alpha="0.7"
        android:padding="@dimen/texto_tiny_margin"
        android:src="@drawable/ic_ph_push_pin"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/conversation_body_short"
        app:layout_constraintEnd_toStartOf="@id/unread_count_badge"
        app:layout_constraintTop_toTopOf="@id/conversation_body_short"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/unread_count_badge"
        android:layout_width="@dimen/small_icon_size"
        android:layout_height="@dimen/small_icon_size"
        android:background="@drawable/texto_circle_background"
        android:gravity="center"
        android:textSize="@dimen/texto_list_tertiary_text_size"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/conversation_body_short"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/conversation_body_short"
        tools:text="42"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>
