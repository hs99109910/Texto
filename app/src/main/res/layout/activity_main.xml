<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <com.texto.sms.views.TextoAppBarLayout
        android:id="@+id/main_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/main_toolbar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@android:color/transparent"
            app:popupTheme="@style/TextoPopupTheme">

            <!--
                The home header is a search capsule, the way Google Messages draws it: the
                brand mark leads, the whole middle is a tappable "search" field, and the gear
                trails. It follows the locale, so under Persian the mark sits on the right.
                The field is not a real EditText: tapping it opens the search panel, which
                owns the input, the date range and the filter chips.
            -->
            <LinearLayout
                android:id="@+id/texto_header_row"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <ImageView
                    android:id="@+id/texto_title"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/app_launcher_name"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher_round" />

                <LinearLayout
                    android:id="@+id/texto_header_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:contentDescription="@string/home_search_hint"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/texto_header_search_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ph_magnifying_glass" />

                    <TextView
                        android:id="@+id/texto_header_search_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:text="@string/home_search_hint"
                        android:textAlignment="viewStart" />

                </LinearLayout>

                <!--
                    Settings. The header's one trailing control, at the 40dp styleHeaderTile
                    actually paints it rather than the 38dp it used to be declared at, with
                    the hit rect padded out to the platform's 48dp floor by expandTouchTarget.
                    The tint is the theme's, not a hard white: a light theme repainted the
                    glyph and the XML value flashed through until it did.
                -->
                <ImageView
                    android:id="@+id/texto_menu_btn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/texto_header_tile_bg"
                    android:clickable="true"
                    android:contentDescription="@string/settings_title"
                    android:focusable="true"
                    android:padding="10dp"
                    android:src="@drawable/ic_ph_gear_six" />

            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

        <include
            android:id="@+id/selection_bar"
            layout="@layout/layout_selection_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.texto.sms.views.TextoAppBarLayout>

    <!-- MAIN CONTENT BELOW TOP BAR -->
    <RelativeLayout
        android:id="@+id/main_nested_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/main_coordinator_wrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <RelativeLayout
                android:id="@+id/main_holder"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!--
                    Drawn above the two frosted bars and offset below them at runtime. Behind
                    them it was invisible on exactly the slow devices it exists for, and the
                    250ms show delay meant a fresh launch showed nothing at all for a quarter
                    of a second, which reads as a broken screen rather than a loading one.
                -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/conversations_progress_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:elevation="12dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:hideAnimationBehavior="outward"
                    app:showAnimationBehavior="inward"
                    tools:visibility="visible" />

                <!--
                    Start-aligned like every other row on the screen (the conversation cards,
                    the search screen's own filter row), not centred: centring a two-or-three
                    chip row inside the full screen width left a fifth of the screen empty on
                    each side, out of proportion with the 16-20dp inset everything else here
                    uses. Matches TextoGlass.FLOATING_BAR_INSET_DP.
                -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/filter_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:elevation="10dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="12dp"
                    android:scrollbars="none" />

                <!--
                    Pull to refresh. The list keeps its id and every painter that reaches for
                    it by that id, so only its parent is new; the spinner is dropped below the
                    two floating bars in setupOverlayBars, where their heights are known.

                    The bottom padding is gone from here: setupOverlayBars measures the FAB and
                    sets it, and a fixed 100dp on top of that was a second, disagreeing answer
                    to the same question.
                -->
                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/conversations_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentTop="true">

                    <com.texto.sms.views.TextoRecyclerView
                        android:id="@+id/conversations_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layoutAnimation="@anim/texto_layout_animation"
                        android:overScrollMode="ifContentScrolls"
                        android:scrollbars="none"
                        android:paddingHorizontal="0dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        app:layoutManager="com.texto.sms.views.TextoLinearLayoutManager" />

                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

                <!--
                    The empty state, declared AFTER the list rather than before it: as an
                    earlier sibling of a full-screen RecyclerView its "start a conversation"
                    button was drawn through the list, but every tap on it landed on the list
                    instead, so the one action an empty screen offers did nothing.

                    One holder, so the mark, the line and the button stay a single centred
                    block. The two text views keep their ids and their own visibility, which
                    is what the activity toggles. Nothing here is italic any more: Persian has
                    no italic and the system had to shear the glyphs to fake it.
                -->
                <LinearLayout
                    android:id="@+id/empty_state_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/filter_bar"
                    android:layout_marginTop="@dimen/texto_bigger_margin"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/texto_activity_margin"
                    android:paddingEnd="@dimen/texto_activity_margin">

                    <ImageView
                        android:id="@+id/empty_state_icon"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_marginBottom="@dimen/texto_activity_margin"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ph_chat_teardrop_text"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/no_conversations_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.8"
                        android:gravity="center"
                        android:text="@string/no_conversations_found"
                        android:textSize="@dimen/texto_bigger_text_size"
                        android:visibility="gone" />

                    <!--
                        A button, not a third line of text: the accent fill, the on-accent ink
                        and the 48dp height are painted in styleEmptyState.
                    -->
                    <TextView
                        android:id="@+id/no_conversations_placeholder_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/texto_activity_margin"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:minWidth="180dp"
                        android:text="@string/start_conversation"
                        android:textSize="@dimen/texto_bigger_text_size"
                        android:visibility="gone" />

                </LinearLayout>
            </RelativeLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <!-- SEARCH OVERLAY -->
        <RelativeLayout
            android:id="@+id/search_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:visibility="gone">

            <!--
                The search panel rides at the TOP of the screen rather than taking over the
                bottom capsule, so the nav pill stays reachable while you search. It carries
                the field, the same filter chips the home screen uses, a Jalali date range,
                and the result count: all four combine.
            -->
            <LinearLayout
                android:id="@+id/texto_search_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:id="@+id/texto_search_capsule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:id="@+id/texto_search_panel_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ph_magnifying_glass" />

                    <EditText
                        android:id="@+id/texto_search_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp"
                        android:textAlignment="viewStart"
                        android:textDirection="locale" />

                    <ImageView
                        android:id="@+id/texto_search_clear"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:clickable="true"
                        android:contentDescription="@string/clear_search"
                        android:focusable="true"
                        android:src="@drawable/ic_ph_x" />

                </LinearLayout>

                <!--
                    Two rows, not one. Date and audience are different questions, and sharing
                    a line meant the date control ate the width the filter chips needed and
                    scrolled them half out of reach. Each now gets the full width, in the
                    order the panel reads: what to find, then when, then who.
                -->
                <HorizontalScrollView
                    android:id="@+id/search_date_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/search_date_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp" />

                </HorizontalScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/search_filter_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="4dp"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/search_result_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="8dp"
                    android:textAlignment="viewStart"
                    tools:text="۱۲ نتیجه" />

            </LinearLayout>

            <TextView
                android:id="@+id/search_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/texto_search_panel"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/texto_activity_margin"
                android:alpha="0.8"
                android:gravity="center"
                android:paddingStart="@dimen/texto_activity_margin"
                android:paddingEnd="@dimen/texto_activity_margin"
                android:text="@string/no_items_found"
                android:textSize="@dimen/texto_bigger_text_size" />

            <TextView
                android:id="@+id/search_placeholder_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/search_placeholder"
                android:layout_centerHorizontal="true"
                android:alpha="0.8"
                android:gravity="center"
                android:paddingStart="@dimen/texto_activity_margin"
                android:paddingTop="@dimen/texto_medium_margin"
                android:paddingEnd="@dimen/texto_activity_margin"
                android:paddingBottom="@dimen/texto_medium_margin"
                android:text="@string/type_2_characters"
                android:textSize="@dimen/texto_bigger_text_size" />

            <com.texto.sms.views.TextoRecyclerView
                android:id="@+id/search_results_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/texto_search_panel"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="120dp"
                android:paddingHorizontal="4dp"
                android:scrollbars="none"
                app:layoutManager="com.texto.sms.views.TextoLinearLayoutManager" />

        </RelativeLayout>
    </RelativeLayout>

    <!-- Where the inline colour bars land, against the bar or card being recoloured. -->
    <FrameLayout
        android:id="@+id/appearance_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!--
        The appearance editor's bar, floating over the list for the same reason the selection
        bar does: what is behind it is what you are restyling, so it must not move. Positioned
        and painted at runtime, like every other floating bar here.
    -->
    <LinearLayout
        android:id="@+id/appearance_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:elevation="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/appearance_cancel"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/appearance_discard"
            android:padding="11dp"
            android:src="@drawable/ic_ph_x" />

        <TextView
            android:id="@+id/appearance_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="@string/appearance_edit_hint_home"
            android:textAlignment="viewStart" />

        <TextView
            android:id="@+id/appearance_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/appearance_edit_done" />

    </LinearLayout>


    <!-- Radiant-only Telegram-style navigation. MainActivity keeps it gone for every other skin. -->
    <LinearLayout
        android:id="@+id/radiant_nav_container"
        android:layout_width="384dp"
        android:layout_height="54dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout android:id="@+id/radiant_messages_btn" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="6dp">
            <ImageView android:id="@+id/radiant_messages_icon" android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_ph_chat_teardrop_text" />
            <TextView android:id="@+id/radiant_messages_label" style="@style/NavBarLabel" android:text="@string/nav_messages" />
        </LinearLayout>
        <LinearLayout android:id="@+id/radiant_contacts_btn" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="6dp">
            <ImageView android:id="@+id/radiant_contacts_icon" android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_ph_users" />
            <TextView android:id="@+id/radiant_contacts_label" style="@style/NavBarLabel" android:text="@string/nav_contacts" />
        </LinearLayout>
        <LinearLayout android:id="@+id/radiant_archive_btn" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="6dp">
            <ImageView android:id="@+id/radiant_archive_icon" android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_ph_archive_box" />
            <TextView android:id="@+id/radiant_archive_label" style="@style/NavBarLabel" android:text="@string/nav_archive" />
        </LinearLayout>
        <ImageView
            android:id="@+id/radiant_compose_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/nav_new_message"
            android:elevation="6dp"
            android:padding="10dp"
            android:src="@drawable/ic_ph_pencil" />
    </LinearLayout>

    <!--
        Start chat. Anchored to the bottom end corner: bottom right under English, bottom left
        under Persian, where the thumb already is. It shrinks to a plain disc while the list
        scrolls down and stretches back out on the way up. Colours are set in MainActivity.
    -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/texto_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/start_chat"
        android:text="@string/start_chat"
        app:icon="@drawable/ic_ph_chat_circle_text" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
