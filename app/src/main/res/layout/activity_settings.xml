<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/settings_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/settings_toolbar"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@android:color/transparent">

            <TextView
                android:id="@+id/settings_toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/settings_title"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginEnd="60dp"
                android:ellipsize="end"
                android:maxLines="1" />

        </com.google.android.material.appbar.MaterialToolbar>

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/settings_nested_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/settings_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:animateLayoutChanges="true">


            <!-- Conversations: screens that used to be reachable only from the main
                 overflow menu, grouped with the block lists they belong beside. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_group_conversations"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp"
                android:alpha="0.7"
                android:textStyle="bold" />

            <RelativeLayout
                android:id="@+id/settings_archived_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="14dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="@string/settings_archived_messages"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/settings_recycle_bin_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="14dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="@string/deleted_messages"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/settings_blocked_numbers_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="@string/blocked_numbers"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    />
                <TextView
                    android:id="@+id/settings_blocked_numbers_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/settings_blocked_keywords_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="14dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="@string/blocked_keywords"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    />
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" android:layout_marginVertical="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_group_filters"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp"
                android:alpha="0.7"
                android:textStyle="bold" />

            <!-- Contacts-only filter: kept on the main settings screen (outside every
                 collapsible section) so it is always visible, per user request. -->
            <RelativeLayout
                android:id="@+id/settings_contacts_only_filter_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="14dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/settings_contacts_only_filter_switch"
                    android:layout_centerVertical="true"
                    android:layout_height="wrap_content"
                    android:text="@string/show_contacts_only_filter"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    />
                <org.fossify.commons.views.MyMaterialSwitch
                    android:id="@+id/settings_contacts_only_filter_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>

            <!-- Ads filter: same always-visible placement as the contacts-only toggle. -->
            <RelativeLayout
                android:id="@+id/settings_ads_filter_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="14dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/settings_ads_filter_switch"
                    android:layout_centerVertical="true"
                    android:layout_height="wrap_content"
                    android:text="@string/show_ads_filter"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    />
                <org.fossify.commons.views.MyMaterialSwitch
                    android:id="@+id/settings_ads_filter_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true" />
            </RelativeLayout>

            <!-- Which filter chip the app opens on. -->
            <RelativeLayout
                android:id="@+id/settings_default_filter_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="14dp">
                <TextView
                    android:id="@+id/settings_default_filter_label"
                    android:layout_width="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/settings_default_filter"
                    android:layout_centerVertical="true"
                    android:layout_height="wrap_content"
                    android:text="@string/default_filter"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    />
                <TextView
                    android:id="@+id/settings_default_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" android:layout_marginVertical="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:text="@string/settings_group_appearance"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp"
                android:alpha="0.7"
                android:textStyle="bold" />

            <!-- Theme picker: deliberately outside every collapsible section so it is
                 the first thing visible when Settings opens. -->
            <RelativeLayout
                android:id="@+id/settings_app_theme_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="@string/app_theme"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    />
                <TextView
                    android:id="@+id/settings_app_theme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />
            </RelativeLayout>

            <!-- Appearance Section -->
            <RelativeLayout android:id="@+id/settings_appearance_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:background="?selectableItemBackground" android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/settings_customization_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_toStartOf="@+id/settings_appearance_arrow" android:text="@string/settings_backgrounds_and_font" android:textColor="@color/colorPrimary" android:textSize="16sp" android:textStyle="bold" />
                <ImageView android:id="@+id/settings_appearance_arrow" android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:src="@drawable/ic_expand_down" app:tint="@color/colorPrimary" />
            </RelativeLayout>
            <LinearLayout android:id="@+id/settings_appearance_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="8dp" android:visibility="gone">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp">
                    <TextView android:id="@+id/settings_top_bar_label" style="@style/SettingsTextLabelStyle" android:layout_width="match_parent" android:layout_alignParentStart="true" android:layout_toStartOf="@+id/settings_top_bar_bg_mode_spinner" android:layout_centerVertical="true" android:text="@string/settings_top_bar_background" />
                    <Spinner android:id="@+id/settings_top_bar_bg_mode_spinner" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_toStartOf="@+id/settings_top_bar_preview_container" android:layout_marginEnd="12dp" />
                    <FrameLayout android:id="@+id/settings_top_bar_preview_container" android:layout_width="32dp" android:layout_height="32dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true"><View android:id="@+id/settings_top_bar_color_preview" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/color_preview_bg" /><ImageView android:id="@+id/settings_top_bar_image_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp" android:src="@drawable/ic_image_vector" android:visibility="gone" /></FrameLayout>
                </RelativeLayout>
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp">
                    <TextView android:id="@+id/settings_main_bg_label" style="@style/SettingsTextLabelStyle" android:layout_width="match_parent" android:layout_alignParentStart="true" android:layout_toStartOf="@+id/settings_main_bg_mode_spinner" android:layout_centerVertical="true" android:text="@string/settings_main_background" />
                    <Spinner android:id="@+id/settings_main_bg_mode_spinner" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_toStartOf="@+id/settings_main_bg_preview_container" android:layout_marginEnd="12dp" />
                    <FrameLayout android:id="@+id/settings_main_bg_preview_container" android:layout_width="32dp" android:layout_height="32dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true"><View android:id="@+id/settings_main_background_color_preview" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/color_preview_bg" /><ImageView android:id="@+id/settings_main_bg_image_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp" android:src="@drawable/ic_image_vector" android:visibility="gone" /></FrameLayout>
                </RelativeLayout>
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp">
                    <TextView android:id="@+id/settings_input_bar_label" style="@style/SettingsTextLabelStyle" android:layout_width="match_parent" android:layout_alignParentStart="true" android:layout_toStartOf="@+id/settings_input_bar_bg_mode_spinner" android:layout_centerVertical="true" android:text="@string/settings_input_bar_background" />
                    <Spinner android:id="@+id/settings_input_bar_bg_mode_spinner" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_toStartOf="@+id/settings_input_bar_preview_container" android:layout_marginEnd="12dp" />
                    <FrameLayout android:id="@+id/settings_input_bar_preview_container" android:layout_width="32dp" android:layout_height="32dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true"><View android:id="@+id/settings_input_bar_background_color_preview" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/color_preview_bg" /><ImageView android:id="@+id/settings_input_bar_image_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp" android:src="@drawable/ic_image_vector" android:visibility="gone" /></FrameLayout>
                </RelativeLayout>
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp">
                    <TextView android:id="@+id/settings_ui_scale_label" style="@style/SettingsTextLabelStyle" android:layout_width="match_parent" android:layout_alignParentStart="true" android:text="@string/settings_ui_scale" />
                    <com.google.android.material.slider.Slider android:id="@+id/settings_ui_scale_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/settings_ui_scale_label" android:layout_marginTop="4dp" android:valueFrom="0.5" android:valueTo="1.5" android:stepSize="0.1" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/settings_font_size_holder" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:background="?selectableItemBackground" android:clickable="true" android:focusable="true">
                    <TextView android:id="@+id/settings_font_size_label" style="@style/SettingsTextLabelStyle" android:layout_width="match_parent" android:layout_alignParentStart="true" android:layout_toStartOf="@+id/settings_font_size" android:layout_centerVertical="true" android:text="@string/settings_font_size" />
                    <TextView android:id="@+id/settings_font_size" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:textColor="@android:color/white" android:textSize="16sp" />
                </RelativeLayout>
                <RelativeLayout android:id="@+id/settings_font_holder" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:background="?selectableItemBackground" android:clickable="true" android:focusable="true">
                    <TextView android:id="@+id/settings_font_label" style="@style/SettingsTextLabelStyle" android:layout_width="match_parent" android:layout_alignParentStart="true" android:layout_toStartOf="@+id/settings_font" android:layout_centerVertical="true" android:text="@string/settings_font" />
                    <TextView android:id="@+id/settings_font" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:textColor="@android:color/white" android:textSize="16sp" />
                </RelativeLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" android:layout_marginVertical="8dp" />

            <!-- Colors Section -->
            <RelativeLayout android:id="@+id/settings_colors_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:background="?selectableItemBackground" android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/settings_ui_colors_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_toStartOf="@+id/settings_colors_arrow" android:text="@string/settings_colors" android:textColor="@color/colorPrimary" android:textSize="16sp" android:textStyle="bold" />
                <ImageView android:id="@+id/settings_colors_arrow" android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:src="@drawable/ic_expand_down" app:tint="@color/colorPrimary" />
            </RelativeLayout>
            <LinearLayout android:id="@+id/settings_colors_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="8dp" android:visibility="gone">
                <RelativeLayout android:id="@+id/settings_top_bar_text_color_holder" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="10dp"><TextView android:id="@+id/settings_top_bar_text_color_label" style="@style/SettingsTextLabelStyle" android:layout_width="match_parent" android:layout_alignParentStart="true" android:layout_toStartOf="@+id/settings_top_bar_text_color_preview" android:layout_centerVertical="true" android:text="@string/settings_top_bar_text" /><View android:id="@+id/settings_top_bar_text_color_preview" android:layout_width="32dp" android:layout_height="32dp" android:layout_alignParentEnd="true" android:background="@drawable/color_preview_bg" /></RelativeLayout>
                <RelativeLayout android:id="@+id/settings_main_text_color_holder" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="10dp"><TextView android:id="@+id/settings_background_color_label" style="@style/SettingsTextLabelStyle" android:layout_width="match_parent" android:layout_alignParentStart="true" android:layout_toStartOf="@+id/settings_main_text_color_preview" android:layout_centerVertical="true" android:text="@string/settings_main_text" /><View android:id="@+id/settings_main_text_color_preview" android:layout_width="32dp" android:layout_height="32dp" android:layout_alignParentEnd="true" android:background="@drawable/color_preview_bg" /></RelativeLayout>
                <RelativeLayout android:id="@+id/settings_input_bar_text_color_holder" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="10dp"><TextView android:id="@+id/settings_input_bar_text_color_label" style="@style/SettingsTextLabelStyle" android:layout_width="match_parent" android:layout_alignParentStart="true" android:layout_toStartOf="@+id/settings_input_bar_text_color_preview" android:layout_centerVertical="true" android:text="@string/settings_input_bar_text" /><View android:id="@+id/settings_input_bar_text_color_preview" android:layout_width="32dp" android:layout_height="32dp" android:layout_alignParentEnd="true" android:background="@drawable/color_preview_bg" /></RelativeLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" android:layout_marginVertical="12dp" />
                <TextView style="@style/SettingsTextLabelStyle" android:layout_width="match_parent" android:text="@string/settings_conversation_card_color" android:textSize="14sp" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
                    <LinearLayout android:id="@+id/settings_color_recent_holder" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="8dp"><View android:id="@+id/settings_color_recent_preview" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/color_preview_bg" /></LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" android:layout_marginVertical="8dp" />

            <!-- Bubbles Section -->
            <RelativeLayout android:id="@+id/settings_bubbles_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:background="?selectableItemBackground" android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/settings_bubble_customization_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_toStartOf="@+id/settings_bubbles_arrow" android:text="@string/settings_message_bubbles" android:textColor="@color/colorPrimary" android:textSize="16sp" android:textStyle="bold" />
                <ImageView android:id="@+id/settings_bubbles_arrow" android:layout_width="24dp" android:layout_height="24dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:src="@drawable/ic_expand_down" app:tint="@color/colorPrimary" />
            </RelativeLayout>
            <LinearLayout android:id="@+id/settings_bubbles_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="8dp" android:visibility="gone">
                <RelativeLayout android:id="@+id/settings_sent_bubble_color_holder" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp"><TextView android:id="@+id/settings_sent_bubble_color_label" style="@style/SettingsTextLabelStyle" android:layout_width="match_parent" android:layout_alignParentStart="true" android:layout_toStartOf="@+id/settings_sent_bubble_color_preview" android:layout_centerVertical="true" android:text="@string/settings_sent_bubble_color" /><View android:id="@+id/settings_sent_bubble_color_preview" android:layout_width="32dp" android:layout_height="32dp" android:layout_alignParentEnd="true" android:background="@drawable/color_preview_bg" /></RelativeLayout>
                <RelativeLayout android:id="@+id/settings_sent_bubble_text_color_holder" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp"><TextView android:id="@+id/settings_sent_bubble_text_color_label" style="@style/SettingsTextLabelStyle" android:layout_width="match_parent" android:layout_alignParentStart="true" android:layout_toStartOf="@+id/settings_sent_bubble_text_color_preview" android:layout_centerVertical="true" android:text="@string/settings_sent_bubble_text" /><View android:id="@+id/settings_sent_bubble_text_color_preview" android:layout_width="32dp" android:layout_height="32dp" android:layout_alignParentEnd="true" android:background="@drawable/color_preview_bg" /></RelativeLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" android:layout_marginVertical="8dp" />
                <RelativeLayout android:id="@+id/settings_received_bubble_color_holder" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp"><TextView android:id="@+id/settings_received_bubble_color_label" style="@style/SettingsTextLabelStyle" android:layout_width="match_parent" android:layout_alignParentStart="true" android:layout_toStartOf="@+id/settings_received_bubble_color_preview" android:layout_centerVertical="true" android:text="@string/settings_received_bubble_color" /><View android:id="@+id/settings_received_bubble_color_preview" android:layout_width="32dp" android:layout_height="32dp" android:layout_alignParentEnd="true" android:background="@drawable/color_preview_bg" /></RelativeLayout>
                <RelativeLayout android:id="@+id/settings_received_bubble_text_color_holder" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp"><TextView android:id="@+id/settings_received_bubble_text_color_label" style="@style/SettingsTextLabelStyle" android:layout_width="match_parent" android:layout_alignParentStart="true" android:layout_toStartOf="@+id/settings_received_bubble_text_color_preview" android:layout_centerVertical="true" android:text="@string/settings_received_bubble_text" /><View android:id="@+id/settings_received_bubble_text_color_preview" android:layout_width="32dp" android:layout_height="32dp" android:layout_alignParentEnd="true" android:background="@drawable/color_preview_bg" /></RelativeLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" android:layout_marginVertical="8dp" />

            <!-- Destructive, so it sits at the very bottom instead of at the top. -->
            <!-- Reset Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">
                <TextView
                    android:id="@+id/settings_reset_defaults"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="?selectableItemBackground"
                    android:padding="8dp"
                    android:text="@string/settings_reset_customization"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="120dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- NAVIGATION BAR -->
    <LinearLayout
        android:id="@+id/nova_nav_container"
        android:layout_width="240dp"
        android:layout_height="55dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="16dp"
        android:background="@drawable/nova_searchbar_bg"
        android:alpha="0.92"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:gravity="center_vertical">

        <FrameLayout android:id="@+id/nav_home_btn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?selectableItemBackground"><ImageView android:id="@+id/nav_home_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_home_modern" android:alpha="0.6" app:tint="@android:color/white" /></FrameLayout>
        <View android:id="@+id/nav_divider1" android:layout_width="1dp" android:layout_height="24dp" android:background="#22FFFFFF" />
        <FrameLayout android:id="@+id/nav_search_btn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?selectableItemBackground"><ImageView android:id="@+id/nova_search_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_search_vector" android:alpha="0.6" app:tint="@android:color/white" /></FrameLayout>
        <View android:id="@+id/nav_divider2" android:layout_width="1dp" android:layout_height="24dp" android:background="#22FFFFFF" />
        <FrameLayout android:id="@+id/nav_settings_btn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="?selectableItemBackground"><ImageView android:id="@+id/nav_settings_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_settings_cog_vector" android:alpha="0.9" app:tint="@android:color/white" /></FrameLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
